# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Configuration
NODE_ENV="development"
PORT="3000"
API_BASE_URL="http://localhost:3000"

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_crm?schema=public"

# Authentication Secrets
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Meta WhatsApp Business Cloud API Configuration
# Get these credentials from https://developers.facebook.com
META_ACCESS_TOKEN=""
META_PHONE_NUMBER_ID=""
META_BUSINESS_ACCOUNT_ID=""
META_VERIFY_TOKEN="whatsapp_webhook_secret_token_123"
META_API_VERSION="v21.0"
META_APP_SECRET=""

# WhatsApp Provider Mode ('meta' or 'mock')
# When credentials are not provided or set to 'mock', the platform seamlessly runs with the Mock Provider
WHATSAPP_PROVIDER="mock"

# Salesforce CRM OAuth 2.0 & REST API Configuration
# Get these credentials from Salesforce Setup > Apps > App Manager > New Connected App
SALESFORCE_ENVIRONMENT="production" # "production" (login.salesforce.com) or "sandbox" (test.salesforce.com)
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
SALESFORCE_REDIRECT_URI="http://localhost:3000/api/salesforce/oauth/callback"
SALESFORCE_INSTANCE_URL=""
SALESFORCE_AUTO_SYNC_MESSAGES="true"
SALESFORCE_AUTO_SYNC_CONTACTS="true"
SALESFORCE_TARGET_OBJECT="Contact" # "Contact", "Lead", or "Both"
SALESFORCE_WEBHOOK_SECRET=""

